{
  "entities": {
    "ServiceNote": {
      "title": "ServiceNote",
      "description": "Nota servis HP & Laptop untuk SE SMART CELL",
      "type": "object",
      "properties": {
        "noteNumber": { "type": "string" },
        "entryDate": { "type": "number" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "deviceType": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "imeiOrSerial": { "type": "string" },
        "accessories": { "type": "string" },
        "issueDescription": { "type": "string" },
        "technicianCheckResult": { "type": "string" },
        "repairAction": { "type": "string" },
        "serviceFee": { "type": "number" },
        "sparepartFee": { "type": "number" },
        "discount": { "type": "number" },
        "downPayment": { "type": "number" },
        "estimatedCompletionDate": { "type": "string" },
        "technicianName": { "type": "string" },
        "serviceStatus": { "type": "string" },
        "warrantyPeriod": { "type": "string" },
        "warrantyEndDate": { "type": "string" },
        "initialPaymentMethod": { "type": "string" },
        "notes": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "noteNumber",
        "customerName",
        "customerPhone",
        "deviceType",
        "brand",
        "model",
        "issueDescription",
        "serviceStatus",
        "userId"
      ]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Catatan transaksi pembayaran servis",
      "type": "object",
      "properties": {
        "noteNumber": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "paymentDate": { "type": "number" },
        "paymentType": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "notes": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "noteNumber",
        "amount",
        "paymentMethod",
        "userId"
      ]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Pengaturan informasi toko, rekening, dan QRIS",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "storeTagline": { "type": "string" },
        "storeAddress": { "type": "string" },
        "storePhone": { "type": "string" },
        "qrisMerchantName": { "type": "string" },
        "qrisNmid": { "type": "string" },
        "bankAccounts": { "type": "string" },
        "ewalletAccounts": { "type": "string" },
        "warrantyTerms": { "type": "string" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "storeName",
        "userId"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/service_notes/{noteId}": {
      "schema": { "$ref": "#/entities/ServiceNote" },
      "description": "Daftar nota service milik teknisi/admin"
    },
    "/users/{userId}/payment_records/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Daftar pembayaran nota"
    },
    "/users/{userId}/store_settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Pengaturan toko per user admin"
    }
  }
}
